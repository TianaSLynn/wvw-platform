# ─── Database ────────────────────────────────────────────────────────────────
# Supabase / Neon / Railway PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/wvw_platform?pgbouncer=true&connection_limit=1"
# Direct connection (for Prisma migrations — bypasses pgBouncer)
DIRECT_URL="postgresql://user:password@host:5432/wvw_platform"

# ─── Clerk Authentication ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WVW Intelligence"

# ─── AI (OpenAI) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-5.5"

# ─── File Storage (Vercel Blob or S3) ───────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# OR S3:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="wvw-evidence"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@wvwconsulting.com"

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex string for encrypting sensitive data (e.g. integration tokens)
ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here"

# ─── n8n Automation (via n8n-mcp) ───────────────────────────────────────────
N8N_API_URL="http://localhost:5678"
N8N_API_KEY="your-n8n-api-key-here"
NEXT_PUBLIC_N8N_URL="http://localhost:5678"
